{
    "name": "fisicabit-bt",
    "version": "1.2.0",
    "description": "FisicaBit con Bluetooth: las categorías FisicaBit USB y FisicaBit BT para enviar datos a fisicabit.com por cable o sin cable. Reemplaza a fisicabit-usb cuando se activa Bluetooth (incompatible con Radio).",
    "license": "MIT",
    "authors": [
        "FisicaBit"
    ],
    "public": true,
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "fisicabit_datos.ts",
        "fisicabit_usb.ts",
        "fisicabit_bt.ts",
        "enums.d.ts",
        "_locales/es/fisicabit-bt-strings.json",
        "_locales/es/fisicabit-bt-jsdoc-strings.json",
        "_locales/en/fisicabit-bt-strings.json",
        "_locales/en/fisicabit-bt-jsdoc-strings.json",
        "_locales/pt-BR/fisicabit-bt-strings.json",
        "_locales/pt-BR/fisicabit-bt-jsdoc-strings.json",
        "tutorial-usb.md",
        "tutorial-bluetooth.md",
        "_locales/es/tutorial-usb.md",
        "_locales/es/tutorial-bluetooth.md",
        "_locales/pt-BR/tutorial-usb.md",
        "_locales/pt-BR/tutorial-bluetooth.md"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "configIsJustDefaults": true,
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
