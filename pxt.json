{
    "name": "fisicabit-bt",
    "version": "1.3.0",
    "description": "micro:bit (V2) only. FisicaBit for fisicabit.com: send data over USB or Bluetooth LE, HC-SR04 / HY-SRF05 ultrasonic distance with physical time stamps (replaces fisicabit-usb; incompatible with radio)",
    "license": "MIT",
    "authors": [
        "FisicaBit"
    ],
    "public": true,
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "data.ts",
        "serial.ts",
        "bluetooth.ts",
        "ultrasonic.ts",
        "enums.d.ts",
        "shims.cpp",
        "pxtparts.json",
        "parts/hcsr04.svg",
        "parts/hysrf05.svg",
        "compat-enums.d.ts",
        "compat.ts",
        "compat-bt.ts",
        "_locales/es/fisicabit-bt-strings.json",
        "_locales/es/fisicabit-bt-jsdoc-strings.json",
        "_locales/pt-BR/fisicabit-bt-strings.json",
        "_locales/pt-BR/fisicabit-bt-jsdoc-strings.json",
        "tutorial-usb.md",
        "_locales/es/tutorial-usb.md",
        "_locales/pt-BR/tutorial-usb.md",
        "tutorial-bluetooth.md",
        "_locales/es/tutorial-bluetooth.md",
        "_locales/pt-BR/tutorial-bluetooth.md"
    ],
    "testFiles": [
        "test.ts"
    ],
