{
    "name": "fisicabit-bt",
    "version": "1.0.0",
    "description": "Extensión micro:bit para fisicabit.com: envío de datos por Bluetooth con un solo bloque (categoría FisicaBit BT). Complemento de fisicabit-usb; incompatible con Radio.",
    "license": "MIT",
    "authors": [
        "FisicaBit"
    ],
    "public": true,
    "dependencies": {
        "core": "*",
        "bluetooth": "*"
    },
    "files": [
        "README.md",
        "fisicabit_bt_datos.ts",
        "fisicabit_bt.ts",
        "_locales/es/fisicabit-bt-strings.json",
        "_locales/es/fisicabit-bt-jsdoc-strings.json",
        "_locales/en/fisicabit-bt-strings.json",
        "_locales/en/fisicabit-bt-jsdoc-strings.json",
        "_locales/pt-BR/fisicabit-bt-strings.json",
        "_locales/pt-BR/fisicabit-bt-jsdoc-strings.json",
        "tutorial-bluetooth.md",
        "_locales/es/tutorial-bluetooth.md",
        "_locales/pt-BR/tutorial-bluetooth.md"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "configIsJustDefaults": true,
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
