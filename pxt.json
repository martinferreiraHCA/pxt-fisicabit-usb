        "fisicabit_ultrasonido.ts",
        "enums.d.ts",
        "_locales/es/fisicabit-usb-strings.json",
        "_locales/es/fisicabit-usb-jsdoc-strings.json",
        "_locales/en/fisicabit-usb-strings.json",
        "_locales/en/fisicabit-usb-jsdoc-strings.json",
        "_locales/pt-BR/fisicabit-usb-strings.json",
        "_locales/pt-BR/fisicabit-usb-jsdoc-strings.json",
        "tutorial-usb.md",
